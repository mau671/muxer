FROM python:3.12-slim

# Install build dependencies - use slim instead of alpine for faster build
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        gcc \
        libc6-dev \
        libffi-dev \
        git \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir uv

# Set working directory
WORKDIR /app

# Copy dependency files and README (required by hatchling)
COPY pyproject.toml uv.lock README.md LICENSE ./

# Create app directory for hatch-vcs version file
RUN mkdir -p app

# Install dependencies (this layer will be cached if deps don't change)
RUN uv sync --group dev --no-cache

# Copy source code
COPY app/ ./app/
COPY run.py ./

# Build the binary
RUN uv run pyinstaller \
    --onefile \
    --name muxer-linux-arm64 \
    --hidden-import=app \
    --add-data "app:app" \
    --strip \
    --noupx \
    run.py

# Verify the binary was created and show its size
RUN ls -la dist/ && \
    echo "Binary size:" && \
    du -h dist/muxer-linux-arm64 && \
    file dist/muxer-linux-arm64 